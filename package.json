{
  "name": "devpath",
  "version": "0.2.0",
  "private": true,
  "description": "Workspace local de DevPath",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @devpath/api dev",
    "dev:engine": "pnpm --filter @devpath/skill-engine dev",
    "dev:web": "pnpm --filter @devpath/web dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json,md}\" \"packages/**/*.{ts,tsx,json,yaml,yml,md}\" \"*.{json,yaml,yml,mjs}\" README.md \"tests/e2e/**/*.{ts,mts,md}\" playwright.config.ts scripts/run-e2e.mjs",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json,md}\" \"packages/**/*.{ts,tsx,json,yaml,yml,md}\" \"*.{json,yaml,yml,mjs}\" README.md \"tests/e2e/**/*.{ts,mts,md}\" playwright.config.ts scripts/run-e2e.mjs",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test && pnpm test:e2e:support",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.e2e.json",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:support": "vitest run --config tests/e2e/vitest.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.14",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.2",
    "globals": "17.13.0",
    "pg": "8.16.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
